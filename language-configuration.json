{
	"comments": {
		"blockComment": ["(*", "*)"]
	},
	"brackets": [
		["(", ")"],
		["[", "]"],
		["{", "}"]
	],
	"autoClosingPairs": [
		{ "open": "(", "close": ")" },
		{ "open": "[", "close": "]" },
		{ "open": "{", "close": "}" },
		{ "open": "\"", "close": "\"", "notIn": ["string", "comment"] }
	],
	"surroundingPairs": [
		["(", ")"],
		["[", "]"],
		["{", "}"],
		["\"", "\""]
	],
	"colorizedBracketPairs": [
		["(", ")"],
		["[", "]"],
		["{", "}"]
	],
	"wordPattern": "[a-zA-Z][a-zA-Z0-9_]*|-?[0-9]*\\.?[0-9]+",
	"indentationRules": {
		"increaseIndentPattern": "^\\s*((urgent\\s+|accepting\\s+)*loc\\b.*|var\\s*|.*\\b(begin|then|do)\\s*|.*\\{\\s*|.*\\belse\\s*)(\\(\\*.*\\*\\)\\s*)?$",
		"decreaseIndentPattern": "^\\s*((urgent\\s+|accepting\\s+)*loc\\b|end\\b|done\\b|else\\b|\\})"
	},
	"onEnterRules": [
		{
			"beforeText": "^\\s*\\(\\*\\*?(?!.*\\*\\)).*$",
			"action": { "indent": "none", "appendText": " * " }
		}
	],
	"folding": {
		"markers": {
			"start": "^\\s*\\(\\*\\s*#?region\\b",
			"end": "^\\s*\\(\\*\\s*#?endregion\\b"
		}
	}
}
