{
	"Model skeleton": {
		"prefix": "model",
		"description": "Complete IMITATOR model: header, var, one automaton, init",
		"body": [
			"(************************************************************",
			" *                      IMITATOR MODEL",
			" * Title            : ${1:title}",
			" * Description      : ${2:description}",
			" * IMITATOR version : 3.4",
			" ************************************************************)",
			"",
			"var",
			"\t${3:x}",
			"\t\t: clock;",
			"\t${4:p}",
			"\t\t: parameter;",
			"",
			"(************************************************************)",
			"  automaton ${5:pta}",
			"(************************************************************)",
			"actions: ${6:a};",
			"",
			"loc ${7:l1}: invariant ${8:True}",
			"\twhen ${9:True} sync ${6:a} goto ${7:l1};",
			"end (* ${5:pta} *)",
			"",
			"(************************************************************)",
			"init := {",
			"\tdiscrete =",
			"\t\tloc[${5:pta}] := ${7:l1},",
			"\t;",
			"\tcontinuous =",
			"\t\t& ${3:x} = 0",
			"\t\t& ${4:p} >= 0",
			"\t;",
			"}",
			"",
			"end",
			"$0"
		]
	},
	"Variable declarations": {
		"prefix": "var",
		"body": [
			"var",
			"\t${1:x}",
			"\t\t: ${2|clock,parameter,int,rational,bool,constant|};",
			"$0"
		]
	},
	"Declaration": {
		"prefix": "decl",
		"description": "name : type;",
		"body": "${1:name} : ${2|clock,parameter,int,rational,bool,constant,binary(8),int array(3),int list,int stack,int queue|};"
	},
	"Constant": {
		"prefix": "const",
		"description": "NAME = value : type;",
		"body": "${1:N} = ${2:1} : ${3|int,rational,constant,bool|};"
	},
	"Automaton": {
		"prefix": "automaton",
		"body": [
			"(************************************************************)",
			"  automaton ${1:name}",
			"(************************************************************)",
			"actions: ${2:a};",
			"",
			"loc ${3:l1}: invariant ${4:True}",
			"\t$0",
			"end (* ${1:name} *)"
		]
	},
	"Location": {
		"prefix": "loc",
		"body": [
			"loc ${1:l}: invariant ${2:True}",
			"\t$0"
		]
	},
	"Urgent location": {
		"prefix": "urgent",
		"body": [
			"urgent loc ${1:l}: invariant True",
			"\t$0"
		]
	},
	"Accepting location": {
		"prefix": "accepting",
		"body": [
			"accepting loc ${1:l}: invariant ${2:True}",
			"\t$0"
		]
	},
	"Location with stopwatch / flow": {
		"prefix": "locflow",
		"body": [
			"loc ${1:l}: invariant ${2:True} stop{${3:x}} flow{${4:y}' = ${5:2}}",
			"\t$0"
		]
	},
	"Transition": {
		"prefix": "when",
		"body": "when ${1:True} sync ${2:a} do {${3:x := 0}} goto ${4:l};$0"
	},
	"Silent transition": {
		"prefix": "whenn",
		"description": "Transition without synchronization",
		"body": "when ${1:True} do {${2:x := 0}} goto ${3:l};$0"
	},
	"Update block": {
		"prefix": "do",
		"body": "do {${1:x := 0}}"
	},
	"If then else": {
		"prefix": "if",
		"body": [
			"if ${1:cond} then",
			"\t${2}",
			"else",
			"\t${3}",
			"end"
		]
	},
	"For loop": {
		"prefix": "for",
		"body": [
			"for ${1:i} from ${2:0} ${3|to,downto|} ${4:9} do",
			"\t$0",
			"done"
		]
	},
	"While loop": {
		"prefix": "while",
		"body": [
			"while ${1:cond} do",
			"\t$0",
			"done"
		]
	},
	"Function": {
		"prefix": "function",
		"body": [
			"function ${1:f}(${2:a : int}) : ${3|int,rational,bool,void|}",
			"begin",
			"\t$0",
			"\treturn ${4:a}",
			"end"
		]
	},
	"Template": {
		"prefix": "template",
		"body": [
			"template ${1:name}(${2:id : int}, ${3:x : clock})",
			"actions: ${4:a};",
			"",
			"loc ${5:l1}: invariant ${6:True}",
			"\t$0",
			"end"
		]
	},
	"Instantiate": {
		"prefix": "instantiate",
		"body": "instantiate ${1:p1} := ${2:template}(${3:1}, ${4:x1});"
	},
	"Init section": {
		"prefix": "init",
		"body": [
			"init := {",
			"\tdiscrete =",
			"\t\tloc[${1:pta}] := ${2:l1},",
			"\t;",
			"\tcontinuous =",
			"\t\t& ${3:x = 0}",
			"\t;",
			"}"
		]
	},
	"Controllable actions": {
		"prefix": "controllable",
		"body": "controllable actions: ${1:a};"
	},
	"Include": {
		"prefix": "#include",
		"body": "#include \"${1:file.imi}\";"
	},
	"Header comment": {
		"prefix": "(**",
		"body": [
			"(************************************************************)",
			"(* ${1:comment} *)",
			"(************************************************************)"
		]
	}
}
